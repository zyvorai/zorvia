// IDE / `npm run typecheck` only — Docusaurus build does not use this file.
// Inlined (not extending @docusaurus/tsconfig) because TS 7 removed `baseUrl`
// while @docusaurus/tsconfig@3.10 still sets it.
{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
